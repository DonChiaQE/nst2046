.venv/
.env
data/*
!data/labels/
!data/eval/
# atc.sqlite is NOT tracked: it is ~23 MB, it is rebuildable from the README's steps 1-2, and it carries UWB-ATCC
# transcript text that this project does not redistribute (see the skip reasons in tests/test_inject.py and
# tests/test_incidents.py). A fresh clone therefore has no events cache, so the tests that need the corpus skip and
# an LLM replay would have to pay for its parses again.
__pycache__/
*.pyc
.DS_Store
.pytest_cache/

# The report drafts and their figures are not tracked; the results docs under
# docs/results/ are the tracked evidence they cite, and the submitted report is
# compiled outside the repo. The glob covers every draft, not just the first two.
docs/milestone2-report-draft*.md
docs/figures/

# Papers we read, not ours to redistribute.
docs/references/

# subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/
