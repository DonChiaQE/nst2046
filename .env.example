# Copy to .env and fill in. Only needed for the LLM arms (atcdb/parse_llm.py); the rules parser,
# the engine, and every script that reads from docs/results/ or data/eval/ need none of this.

# Required for any Sonnet/Haiku parse: scripts/eval_conflicts.py run, scripts/real_2026_cases.py
# --record/--verify, scripts/pilot_cases.py (without --dry-run), and atcdb.parse_llm.availability().
ANTHROPIC_API_KEY=

# Alternative to ANTHROPIC_API_KEY; the SDK accepts either. Leave unset if using the key above.
# ANTHROPIC_AUTH_TOKEN=

# Only if routing through a proxy instead of api.anthropic.com directly.
# ANTHROPIC_BASE_URL=

# Optional: overrides the model the live demo app (atcdb/live_hub.py) uses. Defaults to claude-haiku-5-5.
# RUNWAY_WATCH_CLAUDE_MODEL=
